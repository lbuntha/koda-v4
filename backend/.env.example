# MongoDB connection
MONGO_URI=mongodb://localhost:27017
# Dedicated DB — do NOT use "koda" (that's koda-v3, a different app/schema).
MONGO_DB=koda_v4

# Auth — MUST be a long random string in production (e.g. `openssl rand -hex 32`)
JWT_SECRET=change-me-please-use-a-long-random-string
ACCESS_TOKEN_TTL_MIN=30
REFRESH_TOKEN_TTL_DAYS=30

# CORS — JSON array of allowed frontend origins (Vite dev server)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Optional fallback for the AI proxy. Admins can instead store an encrypted key
# in MongoDB from Settings; credentials are never returned to the browser.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
