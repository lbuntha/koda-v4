# MongoDB connection
MONGO_URI=mongodb://localhost:27017
MONGO_DB=koda

# Auth — MUST be a long random string in production (e.g. `openssl rand -hex 32`)
JWT_SECRET=change-me-please-use-a-long-random-string
ACCESS_TOKEN_TTL_MIN=30
REFRESH_TOKEN_TTL_DAYS=30

# CORS — JSON array of allowed frontend origins (Vite dev server)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# AI generation proxy — the OpenAI key now lives ONLY here, never in the browser
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
