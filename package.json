{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/generate-svg-ids.mjs && node scripts/generate-art-seed.mjs && node scripts/generate-skill-seed.mjs && tsx server.ts",
    "dev:watch": "node scripts/generate-svg-ids.mjs && tsx watch --clear-screen=false --ignore \"src/**\" --ignore \"dist/**\" --ignore \"dev-dist/**\" server.ts",
    "build": "node scripts/generate-svg-ids.mjs && node scripts/generate-art-seed.mjs && node scripts/generate-skill-seed.mjs && vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "icons": "node scripts/generate-pwa-icons.mjs",
    "svg:ids": "node scripts/generate-svg-ids.mjs",
    "voice:record": "node scripts/generate-voice.mjs",
    "art:seed": "node scripts/generate-art-seed.mjs",
    "skills:seed": "node scripts/generate-skill-seed.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "@dicebear/collection": "^9.4.2",
    "@dicebear/core": "^9.4.3",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "http-proxy-middleware": "^4.2.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/ws": "^8.18.1",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "jsdom": "^29.1.1",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11"
  }
}
