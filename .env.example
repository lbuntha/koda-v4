# Copy to .env and fill in. The server loads .env via dotenv.
#
# Both keys below are *fallbacks*. The place to set a key for a running
# deployment is Admin → API keys, which stores it server-side and never sends
# it back to a browser; these are for a dev box that has no database yet.

# The tutor, and artwork drawn from a prompt when the art model is "gemini".
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Artwork drawn by ChatGPT.
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Artwork drawn by Claude.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Which model each art call uses. Defaults shown; override only to pin a model.
# GEMINI_ART_MODEL=gemini-3.7-flash
# OPENAI_ART_MODEL=gpt-5.3-codex

# Shared with the data API (server/.env), and with nothing else.
#
# The deployment's Gemini key is stored in system settings and handed out by one
# endpoint, which asks for this header as well as the caller's token. Leave it
# blank and no family key is ever fetched — GEMINI_API_KEY above is all there
# is, which is fine for a dev box. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
TUTOR_SERVICE_TOKEN=

# Public Web OAuth client id from Google Cloud → Google Auth Platform → Clients.
# Use the same value as GOOGLE_CLIENT_ID in server/.env. Vite bakes this into
# the browser bundle; it is an identifier, not a secret.
VITE_GOOGLE_CLIENT_ID=

# Hold new password accounts at a mailbox-confirmation screen. The API must
# have working SMTP before this is enabled; Google registrations are already
# verified by Google and existing accounts remain usable.
REQUIRE_EMAIL_VERIFICATION=false

# Port the server listens on (default 3000).
PORT=3000
