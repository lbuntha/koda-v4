# Copy to server/.env for local work. Compose passes these in already.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=koda
JWT_SECRET=dev-only-change-me-not-a-real-secret-32b
ENVIRONMENT=development

# Public Web OAuth client id from Google Cloud → Google Auth Platform → Clients.
# It must match VITE_GOOGLE_CLIENT_ID in the root .env so this API accepts only
# ID tokens that Google created for this Koda web app.
GOOGLE_CLIENT_ID=

# Must match TUTOR_SERVICE_TOKEN in the tutor server's .env — it is what
# /v1/system/settings/ai.geminiApiKey/resolve checks before handing out the
# deployment's Gemini key. Unset means that endpoint is off.
TUTOR_SERVICE_TOKEN=

# ── Mail ─────────────────────────────────────────────────────────────────────
# `console` logs the message and sends nothing — the default, and what local
# work wants: the reset link appears in `make logs-api`.
#
# `smtp` sends for real. Two useful targets:
#
#   Mailpit (next door in compose) — a fake server with an inbox at
#   http://localhost:8025. Nothing leaves the machine.
#     MAIL_DRIVER=smtp
#     SMTP_HOST=mailpit
#     SMTP_PORT=1025
#     SMTP_STARTTLS=false
#
#   Gmail — needs an *app password*, not your account password, and the account
#   must have 2-Step Verification on (myaccount.google.com → Security → App
#   passwords). MAIL_FROM must be the same address; Gmail rejects anything else.
#     MAIL_DRIVER=smtp
#     SMTP_HOST=smtp.gmail.com
#     SMTP_PORT=587
#     SMTP_STARTTLS=true
#     SMTP_USER=you@gmail.com
#     SMTP_PASSWORD=<16-character app password>
#     MAIL_FROM=you@gmail.com
MAIL_DRIVER=console

# Enable only after MAIL_DRIVER=smtp is configured and tested. New password
# accounts then receive no session until they use the one-time 24-hour link.
# Existing accounts and Google registrations are unaffected.
REQUIRE_EMAIL_VERIFICATION=false
EMAIL_VERIFICATION_TTL_HOURS=24

# What a link in an email points at. Localhost here; a real domain in production.
APP_BASE_URL=http://localhost:3001
