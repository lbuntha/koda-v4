# Copy to `.env` on the server (deploy/vps/.env) and fill in. Never committed.
#
# Generate each secret with:  openssl rand -hex 32
# Hex on purpose: MONGO_PASSWORD sits inside a connection URL, where characters
# like @ : / would need escaping.

# The address families will use. Its DNS A record must point at this server
# before the first start, or Caddy cannot get a certificate.
DOMAIN=koda.example.com

# --- secrets -------------------------------------------------------------
MONGO_USER=koda
MONGO_PASSWORD=
# Reuse the Cloud Run value to keep everyone signed in across the move; a new
# one signs every family out once.
JWT_SECRET=
# Reuse the Cloud Run value: API keys saved in Admin are read with it.
TUTOR_SERVICE_TOKEN=
# New. Only the API and its `tasks` cron hold it.
TASK_TOKEN=

# --- Google sign-in and push (public identifiers, same as today) ---------
GOOGLE_CLIENT_ID=140757924603-afqgnhe55u0hd1ffv3b8567vucgh10ti.apps.googleusercontent.com
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=learn-with-koda
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_VAPID_KEY=

# `fcm` once secrets/firebase-service-account.json is in place (README.md).
PUSH_DRIVER=console
FIREBASE_PROJECT_ID=learn-with-koda

# --- mail (console = logged, nothing sent; matches production today) -----
MAIL_DRIVER=console
REQUIRE_EMAIL_VERIFICATION=false
SMTP_HOST=
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Koda <no-reply@koda.local>

BACKUP_KEEP_DAYS=14

# --- this server -----------------------------------------------------------
# Where the app listens on 127.0.0.1 for nginx to forward to.
APP_PORT=3101
# MongoDB's memory cache, in GB.
MONGO_CACHE_GB=0.5
