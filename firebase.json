{
  "hosting": {
    "public": ".firebase-hosting",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      {
        "source": "**",
        "run": {
          "serviceId": "koda-app",
          "region": "us-central1",
          "pinTag": true
        }
      }
    ]
  }
}
