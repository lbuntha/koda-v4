{
  "hosting": {
    "public": ".firebase-hosting",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      {
        "source": "/",
        "destination": "https://learnwithkoda.tech/",
        "type": 301
      },
      {
        "source": "/:path*",
        "destination": "https://learnwithkoda.tech/:path*",
        "type": 301
      }
    ]
  }
}
